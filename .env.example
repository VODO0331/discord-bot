# Discord Webhook URLs (由 Discord 頻道設定 -> 整合 -> Webhook 取得)
DISCORD_WEBHOOK_DAILY_URL=https://discord.com/api/webhooks/your_daily_webhook_url
DISCORD_WEBHOOK_ALERT_URL=https://discord.com/api/webhooks/your_alert_webhook_url

# Google Gemini API Key (可由 Google AI Studio 免費取得)
LLM_API_KEY=your_gemini_api_key_here
LLM_PROVIDER=gemini

# Supabase 資料庫連線 (由 Supabase 專案設定 -> API 取得)
SUPABASE_URL=https://your_project_ref.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_role_key
